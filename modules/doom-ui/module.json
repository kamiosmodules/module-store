      "color/kami_slider_active": "#FF81BA96",
      "color/kami_slider_inactive": {
        "day": "#33396F47",
        "night": "#33BBC3C2"
      }
    }
  },
  "settings": {
    "system/qs_tiles_columns": 5,
    "system/qs_tile_shape": 0,
    "system/qs_tile_label_hide": true,
    "system/qs_panel_style": 0,
    "system/kami_blur_strength": 110,
    "system/volume_slider_gradient": true,
    "system/qs_brightness_slider_gradient": true,
    "system/qs_tile_gradient": true,
    "system/custom_gradient_color_mode": 1,
    "system/custom_gradient_start_color": -8146285,
    "system/custom_gradient_end_color": -14927063,
    "global/window_animation_scale": 0.8,
