      },
      "drawable/kami_hero_image": "img/hero.webp",
      "dimen/kami_bento_radius": "8dp",
      "dimen/kami_hero_radius": "10dp",
      "dimen/kami_bento_icon_radius": "6dp",
      "dimen/kami_bento_gap": "8dp",
      "dimen/kami_bento_tile_height": "96dp",
      "integer/kami_bento_columns": 2,
      "integer/kami_switch_duration": 600,
      "color/kami_switch_track_on": "#FF477759",
