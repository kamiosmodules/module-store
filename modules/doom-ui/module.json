{
  "format": "kamios-module",
  "version": 1,
  "id": "doom-ui",
  "name": "Doom-UI",
  "author": "MrSteelballs",
  "description": "MCU Doctor Doom: Latverian cloak green, gunmetal mask bootanimation. Sharp corners, steel glass.",
  "module_version": "1.0",
  "category": "theme",
  "restart": true,
  "accent": "#51966D",
  "accent_style": "SPRITZ",
  "wallpaper": {
    "home": "USER_ADD/home_wallpaper.jpg",
    "lock": "USER_ADD/lock_wallpaper.jpg"
  },
  "bootanimation": "bootanimation.zip",
  "sounds": {
    "lock": "sounds/lock.wav",
    "unlock": "sounds/unlock.wav",
    "charging": "sounds/charging.wav",
    "wireless_charging": "sounds/wireless_charging.wav",
    "low_battery": "sounds/low_battery.wav",
    "screenshot": "sounds/screenshot.wav"
  },
  "settings_layout": {
    "main": {
      "hero": true,
      "columns": 2,
      "text": {
        "title_size": 18,
        "title_lines": 1,
        "summary_size": 12,
        "summary_lines": 2
      },
      "tiles": [
        { "page": "themes", "color": "#FF1C3021", "text_color": "#FFA6BAA6", "size": "full" },
        { "page": "kamios", "color": "#FF122117", "text_color": "#FFA6BAA6", "size": "full" },
        { "page": "network", "color": "#FF1C3021", "text_color": "#FFDCE1E0" },
        { "page": "connected_devices", "color": "#FF122117", "text_color": "#FFDCE1E0" },
        { "page": "sound", "color": "#FF1C3021", "text_color": "#FFDCE1E0" },
        { "page": "display", "color": "#FF122117", "text_color": "#FFDCE1E0" },
        { "page": "notifications", "color": "#FF1C3021", "text_color": "#FFDCE1E0" },
        { "page": "modes", "color": "#FF122117", "text_color": "#FFDCE1E0" },
        { "page": "wallpaper", "color": "#FF1C3021", "text_color": "#FFDCE1E0" },
        { "page": "battery", "color": "#FF122117", "text_color": "#FFDCE1E0" },
        { "page": "storage", "color": "#FF1C3021", "text_color": "#FFDCE1E0" },
        { "page": "apps", "color": "#FF122117", "text_color": "#FFDCE1E0" },
        { "page": "system", "color": "#FF1C3021", "text_color": "#FFDCE1E0" }
      ]
    },
    "pages": {
      "nav": "dock",
      "transition": "depth",
      "blur": 28,
      "glass": {
        "blur": 28,
        "shine": 55,
        "gloss": 38,
        "frost": 8,
        "rim": 80,
        "vibrance": 25,
        "shade": 15
      },
      "title": {
        "case": "upper",
        "size": 28,
        "app": true,
        "app_color": "#FF81BA96"
      },
      "colors": {
        "selected": "#FFFFFFFF",
        "unselected": "#FFA1AAA8",
        "indicator": "#6681BA96",
        "bar": "#66122117"
      },
      "dock": {
        "items": 5,
        "size": 54
      },
      "swipe": true
    }
  },
  "targets": {
    "com.android.systemui": {
      "dimen/qs_corner_radius": "16dp",
      "integer/kami_slider_shape": 1,
      "integer/kami_footer_button_shape": 1,
      "color/kami_qs_tile_active_bg": {
