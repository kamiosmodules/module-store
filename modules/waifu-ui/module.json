{
  "format": "kamios-module",
  "version": 1,
  "id": "waifu-ui",
  "name": "Waifu UI",
  "author": "MrSteelballs",
  "description": "Can't get enough of this waifu, Sounds, walls, shade, pill, everything gets a revamp",
  "module_version": "1.0",
  "category": "theme",
  "restart": true,
  "accent_style": "VIBRANT",
  "home_app": "com.kami.shell",
  "wallpaper": {
    "home": "USER_ADD/home_wallpaper.jpg",
    "lock": "USER_ADD/lock_wallpaper.jpg"
  },
  "bootanimation": "bootanimation.zip",
  "shutdownanimation": "shutdownanimation.zip",
  "sounds": {
    "ringtone": {
      "file": "sounds/ringtone.wav",
      "title": "Sakura chime"
    },
    "notification": {
      "file": "sounds/notification.wav",
      "title": "Sakura ping"
    },
    "alarm": {
      "file": "sounds/alarm.wav",
      "title": "Sakura wake-up"
    },
    "touch": "sounds/touch.wav",
    "keypress_standard": "sounds/keypress_standard.wav",
    "keypress_spacebar": "sounds/keypress_spacebar.wav",
    "keypress_delete": "sounds/keypress_delete.wav",
    "keypress_return": "sounds/keypress_return.wav",
    "keypress_invalid": "sounds/keypress_invalid.wav",
    "lock": "sounds/lock.wav",
    "unlock": "sounds/unlock.wav",
    "trusted": "sounds/trusted.wav",
    "charging": "sounds/charging.wav",
    "wireless_charging": "sounds/wireless_charging.wav",
    "low_battery": "sounds/low_battery.wav",
