{
  "format": "kamios-module",
  "version": 1,
  "id": "stealth-avionics-theme-by-isifat",
  "name": "Stealth Avionics by iSiFAT",
  "author": "iSiFAT",
  "description": "Minimalist aerospace transparent theme",
  "category": "theme",
  "accent": "#38BDF8",
  "accent_style": "TONAL_SPOT",
  "wallpaper": {
    "home": "wall/jet.webp",
    "lock": "wall/jet.webp"
  },
  "launcher_icons": {
    "com.android.settings": "icons/settings.png"
  },
  "qs_style": {
    "base": "stock",
    "panel": {
      "background": "none",
      "blur": 0,
      "alpha": 0,
      "radius": 0,
      "padding": 16,
      "gap": 14
    },
    "header": {
      "style": "stock",
      "clock": true,
      "date": true,
      "edit": true,
      "settings": true,
      "power": true
    },
    "qqs": {
      "columns": 4,
      "rows": 1,
      "media": false,
      "brightness": false
    },
    "tiles": {
      "columns": 4,
      "shape": "circle",
      "size": "icon",
      "radius": 50,
      "height": 76,
      "gap": 14,
      "labels": false,
      "sublabels": false,
      "active_bg": "#38BDF8",
      "active_fg": "#090D16",
      "inactive_bg": "#161F30",
      "inactive_fg": "#E2E8F0"
    },
    "blocks": [
      {
        "type": "row",
        "weights": [
          2,
          1,
          1
        ],
        "gap": 14,
        "children": [
          {
            "type": "tiles",
            "columns": 1,
            "shape": "pill",
            "size": "wide",
            "radius": 50,
            "height": 76,
            "gap": 14,
            "labels": true,
            "sublabels": true,
            "specs": [
              "wifi",
              "cell"
            ]
          },
          {
            "type": "slider",
            "kind": "brightness",
            "orientation": "v",
            "height": 166,
            "radius": 50,
            "fill": "accent"
          },
          {
            "type": "slider",
            "kind": "volume",
            "orientation": "v",
            "height": 166,
            "radius": 50,
            "fill": "accent"
          }
        ]
      },
      {
        "type": "row",
        "weights": [
          1,
          1
        ],
        "gap": 14,
        "children": [
          {
            "type": "ringer",
            "height": 76,
            "radius": 50
          },
          {
            "type": "tiles",
            "columns": 2,
            "shape": "circle",
            "size": "icon",
            "radius": 50,
            "height": 76,
            "gap": 14,
            "labels": false,
            "sublabels": false,
            "specs": [
              "bt",
              "flashlight"
            ]
          }
        ]
      },
      {
        "type": "tiles",
        "columns": 4,
        "shape": "circle",
        "size": "icon",
        "radius": 50,
        "height": 76,
        "gap": 14,
        "labels": false,
        "sublabels": false,
        "specs": [
          "airplane",
          "location",
          "rotation",
          "dnd",
          "battery",
          "hotspot",
          "screenrecord",
          "dark",
          "nfc",
          "saver"
        ]
      }
    ]
  },
  "settings_layout": {
    "main": {
      "hero": false,
      "style": "list",
      "text": {
        "title_size": 17,
        "title_lines": 1,
        "summary_lines": 0
      },
      "tiles": [
        {
          "page": "network"
        },
        {
          "page": "connected_devices"
        },
        {
          "page": "themes"
        },
        {
          "page": "wallpaper"
        },
        {
          "page": "display"
        },
        {
          "page": "sound"
        },
        {
          "page": "notifications"
        },
        {
          "page": "battery"
        },
        {
          "page": "storage"
        },
        {
          "page": "apps"
        },
        {
          "page": "safety_center"
        },
        {
          "page": "security"
        },
        {
          "page": "privacy"
        },
        {
          "page": "location"
        },
        {
          "page": "accessibility"
        },
        {
          "page": "kamios"
        },
        {
          "page": "system"
        },
        {
          "page": "about_device"
        }
      ]
    },
    "pages": {
      "nav": "none",
      "transition": "slide",
      "title": {
        "case": "normal",
        "size": 32,
        "app": true
      }
    }
  },
  "settings": {
    "global/window_animation_scale": 0.85,
    "global/transition_animation_scale": 0.85,
    "global/animator_duration_scale": 0.85
  },
  "targets": {
    "com.android.settings": {
      "bool/kami_page_translucent": true,
      "bool/kami_page_show_wallpaper": true,
      "dimen/kami_page_blur": "30dp",
      "color/kami_page_bg": {
        "day": "#66F1F5F9",
        "night": "#66090D16"
      },
      "color/kami_list_row": {
        "day": "#66FFFFFF",
        "night": "#66131B2B"
      },
      "color/kami_bento_row_icon": {
        "day": "#FF334155",
        "night": "#FF94A3B8"
      },
      "dimen/kami_list_radius": "24dp",
      "dimen/kami_list_inner_radius": "4dp",
      "color/kami_switch_track_on": "#FFE84A5F",
      "color/kami_switch_track_off": "#661E293B",
      "color/kami_switch_thumb_on": "#FFFFFFFF",
      "color/kami_switch_thumb_off": "#FF94A3B8",
      "bool/kami_switch_icons_hidden": true,
      "integer/kami_switch_duration": 200,
      "color/kami_slider_active": "#FF38BDF8",
      "color/kami_slider_inactive": "#661E293B"
    },
    "com.android.systemui": {
      "dimen/volume_dialog_background_surface_blur_radius": "30dp",
      "dimen/volume_dialog_background_square_corner_radius": "28dp",
      "dimen/volume_dialog_ringer_selected_button_background_radius": "24dp",
      "color/kami_volume_dialog_background": {
        "day": "#66F1F5F9",
        "night": "#66090D16"
      },
      "color/kami_volume_slider_active": {
        "day": "#FF0284C7",
        "night": "#FF38BDF8"
      },
      "color/kami_sheet_tint": "#66090D16",
      "integer/kami_sheet_blur": 30,
      "integer/kami_sheet_corner": 28,
      "color/kami_back_arrow": "#FF38BDF8",
      "color/kami_back_arrow_bg": "#99131B2B",
      "integer/kami_unlock_duration": 260,
      "dimen/kami_unlock_start_scale": 0.94
    },
    "com.android.launcher3": {
      "dimen/kami_launch_duration_scale": 0.78,
      "dimen/kami_close_speed": 1.3,
      "dimen/kami_pill_stiffness": 460,
      "dimen/kami_pill_damping": 0.88,
      "dimen/swipe_up_rect_x_damping_ratio": 0.98,
      "dimen/swipe_up_rect_y_damping_ratio": 0.98
    },
    "android": {
      "integer/kami_activity_dur": 310,
      "integer/kami_task_dur": 340,
      "integer/kami_fragment_open_dur": 260,
      "integer/kami_fragment_close_dur": 150,
      "integer/config_shortAnimTime": 150,
      "integer/config_mediumAnimTime": 280,
      "integer/config_longAnimTime": 350,
      "integer/config_activityShortDur": 120,
      "integer/config_activityDefaultDur": 175,
      "string/kami_curve_fast_out_slow_in": "M 0,0 C 0.22,1 0.36,1 1,1",
      "string/kami_curve_emphasized": "M 0,0 C 0.18,0 0,1 1,1"
    }
  }
}