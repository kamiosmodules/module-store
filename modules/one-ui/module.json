        {
          "page": "connected_devices"
        },
        {
          "page": "modes"
        },
        {
          "page": "sound"
        },
        {
          "page": "notifications"
        },
        {
          "page": "display"
        },
        {
          "page": "wallpaper"
        },
        {
          "page": "themes"
        },
        {
          "page": "battery"
        },
        {
          "page": "safety_center"
        },
        {
          "page": "security"
        },
        {
          "page": "privacy"
        },
        {
          "page": "location"
