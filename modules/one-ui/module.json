      "dimen/kami_bento_radius": "32dp",
      "dimen/kami_hero_radius": "38dp",
      "dimen/kami_bento_icon_radius": "13dp",
      "dimen/kami_bento_gap": "4dp",
      "dimen/kami_bento_tile_height": "72dp",
      "integer/kami_bento_columns": 1,
      "color/kami_bento_tile": {
        "day": "#FFFFFFFF",
        "night": "#FF171717"
      },
      "color/kami_bento_hero": {
        "day": "#FFFFFFFF",
        "night": "#FF171717"
      },
      "color/kami_page_bg": {
        "day": "#FFF6F6F6",
        "night": "#FF000000"
      },
      "color/kami_switch_track_off": {
        "day": "#FFC9CDD4",
        "night": "#FF3A3C41"
      },
      "color/kami_switch_thumb_on": "#FFFFFFFF",
      "color/kami_switch_thumb_off": {
        "day": "#FFFFFFFF",
        "night": "#FFB8BBC2"
      },
      "bool/kami_switch_icons_hidden": true,
      "color/kami_slider_inactive": {
        "day": "#FFD9DCE2",
        "night": "#FF3A3C41"
      },
