{
  "format": "kamios-module",
  "version": 1,
  "id": "one-ui",
  "name": "One UI",
  "author": "MrSteelballs",
  "description": "NEW UPDATE: OneUI launcher port, New statusbar icons. One UI look: pill tiles, wide Wi-Fi/Bluetooth, soft cards, grouped Settings rows, bootanimation, fonts and sounds.",
  "module_version": "1.2",
  "category": "theme",
  "restart": true,
  "accent": "#3E91FF",
  "accent_style": "TONAL_SPOT",
  "home_app": "com.sec.android.app.launcher",
  "apps": [
    {
      "package": "com.sec.android.app.launcher",
      "apk": "apk/fucksamsung.apk",
      "cert": "bbaf209e18a6abef2d624443fa587a73a28ceeb96d6234677f8575721cdc7de6",
      "keep_data": true
    }
  ],
  "qs_style": {
    "base": "oneui",
    "header": {
      "style": "oneui"
    }
  },
  "wallpaper": {
    "home": "user/wallpaper.jpg",
    "lock": "user/wallpaper1.jpg"
  },
  "fonts": {
    "regular": {
      "file": "fonts/Chococooky.ttf",
      "axes": {
        "wght": 400
      }
    },
    "medium": {
      "file": "fonts/Chococooky.ttf",
      "axes": {
        "wght": 500
      }
    },
    "bold": {
      "file": "fonts/Chococooky.ttf",
      "axes": {
        "wght": 700
      }
    }
  },
  "bootanimation": "bootanimation.zip",
  "sounds": {
    "ringtone": "sounds/ringtone.wav",
    "notification": "sounds/notification.wav",
    "alarm": "sounds/alarm.wav",
    "touch": "sounds/touch.wav",
    "lock": "sounds/lock.wav",
    "unlock": "sounds/unlock.wav",
    "charging": "sounds/charging.wav",
    "wireless_charging": "sounds/wireless_charging.wav",
    "low_battery": "sounds/low_battery.wav",
    "screenshot": "sounds/screenshot.wav"
  },
  "targets": {
    "com.android.systemui": {
      "color/shade_panel_fallback": {
        "day": "#FFF1F2F6",
        "night": "#FF2A2B2F"
      },
