          "page": "supervision"
        },
        {
          "page": "support"
        },
        {
          "page": "about_device"
        },
        {
          "page": "kamios"
        }
      ]
    },
    "pages": {
      "nav": "none"
    }
  },
  "settings": {
    "global/window_animation_scale": 0.9,
    "global/transition_animation_scale": 0.9,
    "global/animator_duration_scale": 0.9,
    "system/kami_shade_dual_tone": false,
    "system/kami_blur_strength": 120,
    "system/screen_off_animation": 0
  },
  "options": {
    "accent": {
      "title": "Accent colour",
      "default": "blue",
      "choices": {
        "blue": {
          "title": "One UI blue",
          "targets": {
            "com.android.systemui": {
              "color/kami_volume_slider_active": "#FF3E91FF",
              "color/kami_lockscreen_shortcut_active_bg": "#FF3E91FF"
            },
            "com.android.settings": {
              "color/kami_switch_track_on": "#FF3E91FF",
              "color/kami_slider_active": "#FF3E91FF"
            }
          }
        },
        "system": {
          "title": "Follow Material You",
          "targets": {
            "com.android.systemui": {
              "color/kami_volume_slider_active": {
                "day": "@android:color/system_accent1_600",
                "night": "@android:color/system_accent1_300"
              },
              "color/kami_lockscreen_shortcut_active_bg": {
                "day": "@android:color/system_accent1_600",
                "night": "@android:color/system_accent1_300"
              }
            },
            "com.android.settings": {
              "color/kami_switch_track_on": {
                "day": "@android:color/system_accent1_600",
                "night": "@android:color/system_accent1_300"
              },
              "color/kami_slider_active": {
                "day": "@android:color/system_accent1_600",
                "night": "@android:color/system_accent1_300"
              }
            }
          }
        },
        "green": {
          "title": "Green",
          "targets": {
            "com.android.systemui": {
              "color/kami_volume_slider_active": "#FF2FBF71",
              "color/kami_lockscreen_shortcut_active_bg": "#FF2FBF71"
            },
            "com.android.settings": {
              "color/kami_switch_track_on": "#FF2FBF71",
              "color/kami_slider_active": "#FF2FBF71"
            }
          }
        },
        "purple": {
          "title": "Purple",
          "targets": {
            "com.android.systemui": {
              "color/kami_volume_slider_active": "#FF8E6CF0",
              "color/kami_lockscreen_shortcut_active_bg": "#FF8E6CF0"
            },
            "com.android.settings": {
              "color/kami_switch_track_on": "#FF8E6CF0",
              "color/kami_slider_active": "#FF8E6CF0"
            }
          }
        }
      }
    },
    "back": {
      "title": "Back swipe",
      "default": "stock",
      "choices": {
        "stock": {
          "title": "Stock (shrinking card)"
        },
        "fade": {
          "title": "Soft fade",
          "targets": {
            "com.android.systemui": {
              "string/kami_back_style": "fade"
            }
          }
        },
        "zoom": {
          "title": "Zoom",
          "targets": {
            "com.android.systemui": {
              "string/kami_back_style": "zoom"
            }
          }
        }
      }
    }
