
{
  "format": "kamios-module",
  "version": 1,
  "id": "pixelcraft-kamios",
  "name": "PixelCraft UI for KamiOS/CumOS-RE",
  "author": "Prabhu",
  "description": "Cyber Pixel UI with square black inactive QS tiles, purple active tiles, built-in QS transitions, pixel-art icons, rounded purple sliders, and a custom wallpaper",
  "settings": {
    "system/qs_panel_style": 0,
    "system/qs_tile_shape": 0,
    "system/qs_tile_animation_style": 2,
    "system/qs_show_volume_slider": 0,
    "system/qs_brightness_slider_shape": 0,
    "system/qs_footer_show_edit": true,
    "system/qs_footer_show_settings": true,
    "system/qs_footer_show_power_menu": true,
    "system/qs_tile_gradient": false,
    "system/qs_brightness_slider_gradient": false,
    "system/volume_slider_gradient": false,
    "system/kami_qs_dual_tone": false,
    "system/kami_shade_dual_tone": false,
    "system/kami_dialog_blur": false,
    "lineage_system/status_bar_clock": 2,
    "lineage_system/status_bar_battery_style": 0,
